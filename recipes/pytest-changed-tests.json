{
  "version": 1,
  "budget_seconds": 120,
  "max_changed_files": 200,
  "cache": true,
  "cache_failures": true,
  "max_cache_entries": 50,
  "max_output_chars": 16000,
  "checks": [
    {
      "name": "Changed pytest files",
      "include": [
        "test_*.py",
        "*_test.py",
        "tests/**/*.py"
      ],
      "exclude": [
        ".codex/cache/**"
      ],
      "command": [
        "python3",
        "-m",
        "pytest",
        "-q",
        "{files}"
      ],
      "timeout_seconds": 90,
      "max_files": 40
    }
  ]
}
